{:jolt/min-version "0.8.16"
 ;; Jolt's floor is the LATEST tagged release — the host is young and moves
 ;; fast, so kmet targets the newest release rather than the oldest one a
 ;; feature needs (jolt/README.md § Bundled-extension loader floor). The
 ;; line's old 0.8.11 floor was the first fixed one for :jolt/native :static
 ;; archives; 0.8.12 already carried jolt.loader/embedded-root?, the
 ;; bundled-extension native loader's floor. Static dist builds additionally
 ;; verify Jolt emitted process-symbol loads for every file-backed native, so
 ;; an older compiler cannot silently produce a dynamic-dependent artifact.

 :paths ["src" "tasks"]
 ;; tasks/ (the bb-task implementations) is a source root but deliberately NOT
 ;; an embed root: :paths are runtime source roots resolved against JOLT_PWD
 ;; (and the app's own require closure decides what compiles), so task code is
 ;; requireable — `jolt dist` needs kmet.tasks.build-jolt — without being
 ;; compiled into, or baked into, the binary.
 ;;
 ;; `jolt build` (driven by kmet.tasks.build-jolt, the jolt branch of the `dist`
 ;; task) bakes every file under each :embed root into the binary, keyed by its
 ;; path below the root — so the model catalogs (io/resource
 ;; "kmet/ai/model_data/…") are embedded, not merely found next to the
 ;; checkout. target/kmet-version is the packager's own root: `jolt dist`
 ;; writes kmet/version.txt there before the build, so the binary reports the
 ;; version it was built as (`kmet --version`) instead of describing whatever
 ;; checkout it happens to run in; a missing root embeds nothing, which is what
 ;; a direct `jolt build` gets (then the runtime falls back to git describe).
 ;; target/kmet-bundled is the staged bundled-extension tree
 ;; (kmet.tasks.build/stage-bundled-extensions!): its contents keep the repo's
 ;; extensions/<name>/src layout, so io/resource reads a bundled extension at
 ;; the same path in a binary as in a checkout. A
 ;; missing root embeds nothing — the runtime then offers no bundled set.
 :jolt/build {:embed ["src" "target/kmet-version" "target/kmet-bundled"]}

 ;; OpenSSL stays dynamically loaded for run/repl and for the default dist mode
 ;; on Linux (including WSL), macOS, and other non-Windows platforms. Windows
 ;; defaults to static; --static/--dynamic override either default. The specs
 ;; keep runtime candidates for dynamic builds and add per-platform archives for
 ;; static ones. The project-level specs are first through Jolt's name-keyed
 ;; reconciliation, so they also retain the dependency libraries' candidates.
 ;; kmet's dist task stages the selected platform's archives before invoking
 ;; `jolt build` and verifies the generated native loads. The process-native
 ;; socket entry needs no archive.
 :jolt/native [{:name "crypto"
                :static {:linux   {:archive "target/jolt-native/linux/libcrypto.a"}
                         :darwin  {:archive "target/jolt-native/darwin/libcrypto.a"}
                         :windows {:archive "target/jolt-native/windows/libcrypto.a"}}
                :darwin ["/opt/homebrew/opt/openssl@3/lib/libcrypto.dylib"
                         "/usr/lib/libcrypto.dylib" "libcrypto.dylib"]
                :linux ["libcrypto.so.3" "libcrypto.so.1.1" "libcrypto.so"]
                :windows ["libcrypto-3-x64.dll" "libcrypto-3.dll"
                          "libcrypto-1_1-x64.dll" "libcrypto.dll"]}
               {:name "ssl"
                :static {:linux   {:archive "target/jolt-native/linux/libssl.a"}
                         :darwin  {:archive "target/jolt-native/darwin/libssl.a"}
                         :windows {:archive "target/jolt-native/windows/libssl.a"}}
                :darwin ["/opt/homebrew/opt/openssl@3/lib/libssl.dylib"
                         "/usr/lib/libssl.dylib" "libssl.dylib"]
                :linux ["libssl.so.3" "libssl.so.1.1" "libssl.so"]
                :windows ["libssl-3-x64.dll" "libssl-3.dll"
                          "libssl-1_1-x64.dll" "libssl.dll"]}]

 :deps {        ;; babashka.fs / babashka.process are deliberately NOT deps: babashka
        ;; bundles them, and jolt vendors the same namespaces (built-in,
        ;; resolving ahead of any deps.edn copy). A Maven copy is redundant on
        ;; both hosts and only risks shadowing the vendored one. jolt's public
        ;; surfaces are jolt.fs / jolt.process (the vendored impls; jolt.fs now
        ;; carries zip/unzip/gzip on the runtime's java.util.zip); kmet
        ;; requires babashka.fs/process directly, which resolves to the
        ;; vendored copy on jolt.

        org.clojure/data.json {:mvn/version "2.5.2"}
        ;; ^ 2.5.2 on both hosts: babashka >= 1.13.224 bundles data.json
        ;; (2.5.2 as of 1.13.225) and the built-in wins over any declared
        ;; copy, so the pre-bundling concern (>= 2.5 uses definterface,
        ;; json.clj InternalPBR, which SCI would not analyze) is gone;
        ;; bb.edn pins the same version.
        ;; java.time formatting/zone layer on Jolt (DateTimeFormatter,
        ;; ZoneId/ZoneOffset, ZonedDateTime — RFC 0008; inert on bb/JVM,
        ;; where the JDK already provides these classes). This revision is
        ;; the merge carrying the zone-aware LocalDateTime factories that
        ;; close jolt#1197: ofInstant, and ofEpochSecond applying its offset
        ;; (jolt-lang/time#18).
        ;; jolt-lang/time#19: tick's cljc.java-time hard-depends on the
        ;; ClojureScript cljs.java-time (11.7 MB of js-joda externs, all but
        ;; ~5 KB unused on Jolt). Remove this exclusion when the pin moves to
        ;; a revision that excludes it upstream.
        io.github.jolt-lang/time {:git/url "https://github.com/jolt-lang/time.git"
                                  :git/sha "faff43aa3260bf79bb3fba10f6d9336190f83281"
                                  :exclusions [com.widdindustries/cljs.java-time]}
        ;; OpenSSL-backed javax.crypto/java.security shims on Jolt
        ;; (MessageDigest, Mac, Cipher, SecureRandom, EC + RSA
        ;; Signature/KeyPairGenerator/KeyFactory — RFC 0014; inert on bb/JVM).
        ;; RSA (keygen + SHA*withRSA + RSA KeyFactory) comes from the library,
        ;; as do the libcrypto/libssl runtime candidates. The project-level
        ;; specs above retain those candidates and add static archives.
        ;; v0.0.10 (feb25f70, 2026-10-01): honors off/len in the byte-array
        ;; update/digest/doFinal overloads and the key/IV spec constructors,
        ;; fixes the quadratic MessageDigest.update, drops the Apple
        ;; libcrypto stub fallback, and declares the link-libs its static
        ;; archives need. Keyed jolt-lang/jolt-crypto to match the name
        ;; upstream http-client depends on: the shared key lets this root
        ;; pin supersede the transitive v0.0.9 instead of resolving a
        ;; second crypto copy.
        jolt-lang/crypto {:git/url "https://github.com/jolt-lang/crypto.git"
                               :git/sha "feb25f70c76ff1030f621817a31723a183ece80b"}
        ;; babashka.http-client on Jolt: the jolt-lang/http-client library's
        ;; java.net.http shims (RFC 0014 :jolt/provides over BSD sockets +
        ;; OpenSSL + libz via jolt.ffi) run the real org.babashka/http-client
        ;; Maven artifact unmodified. The mvn dep feeds the jolt classpath
        ;; (bb has http-client built in; plain JVM clojure gets it too).
        ;; kmet.libs.http routes direct/http-proxy traffic through it on
        ;; Jolt — curl stays only for SOCKS/https-scheme proxies.
        org.babashka/http-client {:mvn/version "0.4.25"}
        ;; The shims behind babashka.http-client on Jolt. PR #25 dropped
        ;; the libz shims and stale java.util.zip claims; PR #27 fixed body
        ;; timeouts; PR #29 added the Windows Winsock transport (http-client
        ;; v0.0.15, fixing http-client#28); PR #31 (v0.0.17, 77d7e310) retried
        ;; interrupted connects and released TLS streams/contexts once a
        ;; connection fails. Pin the merge so the default :platform transport
        ;; works on Windows too. OpenSSL comes from jolt-crypto;
        ;; java.util.zip is runtime surface from Jolt 0.8.9.
        ;; Pinned to unreleased main (d99af98, PR #34's merge) until the
        ;; first release carrying it: PR #34 drops the stale
        ;; java.util.concurrent.CompletableFuture claim and floors the
        ;; library at Jolt 0.8.16 (now the floor here), and PR #33 exits its
        ;; test runners via jolt's wait and bumps crypto to v0.0.10 (kmet
        ;; pins that revision already). On v0.0.17 every Jolt run printed
        ;; the dropped-claim warning. Move to the v0.0.18+ tag when it ships
        ;; (jolt-lang/http-client#32, jolt-bugs.md).
        io.github.jolt-lang/http-client {:git/url "https://github.com/jolt-lang/http-client.git"
                                         :git/sha "d99af98cc97dcb2e4afc3eee142166585a26b859"}
        ;; cljfmt / spec.alpha / rewrite-clj serve the format tasks
        ;; (kmet.tasks.format — one code path on both hosts) AND the fixed
        ;; bundled extension set (kmet.app.extension-libs, src/kmet/extension.md §
        ;; Bundled extension libraries): jolt dist AOT-compiles them in,
        ;; and extension contexts share the loaded namespaces by reference.
        ;; bb.edn carries the same cljfmt version for babashka; bb's
        ;; bundled ports serve spec.alpha/rewrite-clj there.
        ;; org.clojure/spec.alpha is declared explicitly: jolt's resolver
        ;; drops cljfmt's org.clojure/clojure dep (vendored core), and
        ;; cljfmt.config requires clojure.spec.alpha. rewrite-clj is pinned
        ;; to the version the supported babashka bundles — 1.3.58 as of the
        ;; 1.13.225 min-bb floor (bb's built-in wins over cljfmt's transitive
        ;; 1.2.50 there, so bb formats with it) — to keep both hosts on the
        ;; same parser — no longer a workaround, just parity.
        dev.weavejester/cljfmt {:mvn/version "0.16.6"}
        ;; 0.5.238, not 0.6.249: the newer line updates to Clojure 1.12.4 and
        ;; jolt vendors Clojure 1.11.0-jolt. Feeds cljfmt's config require
        ;; and the fixed extension set.
        org.clojure/spec.alpha {:mvn/version "0.5.238"}
        rewrite-clj/rewrite-clj {:mvn/version "1.3.58"}
        ;; the two remaining fixed-set roots: parinferish (delimiter-repair
        ;; tokenizer, pure Clojure) and edamame (reader-error detection).
        ;; edamame would arrive transitively via the jolt/ sci pin; declared
        ;; so dropping that pin cannot silently drop it from the set.
        parinferish/parinferish {:mvn/version "0.8.0"}
        borkdude/edamame {:mvn/version "1.6.44"}
        ;; kmet's own RFC 0014 provider lib (jolt/ dir): the JDK classes the
        ;; jolt ecosystem lacks. Empty by design — v0.8.6-98 supplies every
        ;; gap it was built for, so :jolt/provides is {} and install! is a
        ;; no-op; the scaffolding stays for the next gap. Inert on bb/JVM.
        jolt.kmet/providers {:local/root "jolt"}}
 :aliases
 {:dev {:extra-paths ["test"]}
  ;; jolt dist --test: the only source roots a test build adds — test/ and the
  ;; generated entry root (kmet.tasks.build/generate-test-main!). target/
  ;; scratch, so `bb clean` removes it. Kept separate from :dev so the build
  ;; argv names the test roots and not a dev-mode-looking alias.
  :kmet-test {:extra-paths ["test" "target/kmet-test-entry"]}}}

{:deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}
        ;; 1.2.57 = the version bb bundles: bb serves its adapted port (the
        ;; Maven copy is dropped from the closure — it needs
        ;; clojure.tools.reader.impl.* that bb does not ship), jolt loads the
        ;; Maven jar. Pinned so both hosts parse with the same parser.
        rewrite-clj/rewrite-clj {:mvn/version "1.2.57"}
        ;; delimiter error detection; 1.5.39 = bb's bundled version (SCI's
        ;; edamame). Same story: dropped from bb's closure, Maven on jolt.
        borkdude/edamame {:mvn/version "1.5.39"}
        ;; pure-Clojure delimiter repair (SCI-compatible; parinfer is a JVM lib)
        parinferish/parinferish {:mvn/version "0.8.0"}}}

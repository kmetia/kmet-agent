{:paths ["src" "test" "../../test"
         "../../modules/libs/src"
         "../../modules/mcp/src"
         "../../modules/libs/test"
         "../../modules/ai/src"
         "../../modules/sklop/src" "../../modules/app/src"]
 :deps {;; the extracted libraries are sibling checkouts; the app and module
        ;; trees require them, and the release classpath pins the same coordinates.
        kmet/loader {:local/root "../../../loader"}
        kmet/reakt {:local/root "../../../reakt"}
        kmet/hikap {:local/root "../../../hikap"}
        kmet/srce {:local/root "../../../srce"}
        kmet/tk {:local/root "../../../tk"}
        kmet/tui {:local/root "../../../tui"}
        dev.weavejester/cljfmt {:mvn/version "0.16.6"
                                :exclusions [rewrite-clj/rewrite-clj]}
        parinferish/parinferish {:mvn/version "0.8.0"}
        ;; clojure-edit loads kmet.ui.tui.tool-renderers,
        ;; whose kmet.libs.json seam requires
        ;; clojure.data.json — bb >= 1.13.224 bundles it (the built-in wins),
        ;; declared here for a standalone classpath and version-aligned with
        ;; the root deps.edn.
        org.clojure/data.json {:mvn/version "2.5.2"}
        ;; the module trees require malli at load time
        ;; (kmet.app.config-schema), pinned at the root deps.edn version.
        metosin/malli {:mvn/version "0.20.3"}}
 :tasks
 {test {:doc "Run clojure extension tests (args: test namespace names)"
        :task (let [nss (or (some->> *command-line-args* (map symbol))
                            '[kmet.libs.test-clj-edit
                              kmet.libs.test-clj-eval
                              kmet.extensions.clojure.edit-tool-test
                              kmet.extensions.clojure.sexp-tool-test
                              kmet.extensions.clojure.paren-repair-test
                              kmet.libs.test-nrepl
                              kmet.extensions.clojure.eval-tool-test])]
                (doseq [ns-sym nss]
                  (require ns-sym))
                (let [summary (apply clojure.test/run-tests nss)]
                  (when (pos? (+ (:fail summary) (:error summary)))
                    (System/exit 1))))}}}

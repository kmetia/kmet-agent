{:paths ["src" "test"
         "../../modules/reakt/src"
         "../../modules/hikap/src" "../../modules/libs/src"
         "../../modules/tui/src" "../../modules/ai/src"
         "../../modules/loader/src"
         "../../modules/srce/src" "../../modules/app/src"
         "../../modules/tk/src"]
 :deps {;; tests load the module trees, whose kmet.libs.http requires the
        ;; kmet.libs.json seam → clojure.data.json — bb >= 1.13.224 bundles
        ;; it (the built-in wins), declared for a standalone classpath and
        ;; version-aligned with the root deps.edn.
        org.clojure/data.json {:mvn/version "2.5.2"}
        ;; the module trees require malli at load time
        ;; (kmet.app.config-schema), pinned at the root deps.edn version.
        metosin/malli {:mvn/version "0.20.1"}}
 :tasks
 {test {:doc "Run tree-sitter extension tests (args: namespace symbols; defaults to the offline set)"
        :task (let [nss (or (some->> *command-line-args* (map symbol))
                            '[kmet.extensions.tree-sitter.paths-test
                              kmet.extensions.tree-sitter.fetch-test
                              kmet.extensions.tree-sitter.cli-test
                              kmet.extensions.tree-sitter.grammars-test
                              kmet.extensions.tree-sitter.symbols-test
                              kmet.extensions.tree-sitter.tools-test
                              kmet.extensions.tree-sitter.renderers-test
                              kmet.extensions.tree-sitter.validate-test
                              kmet.extensions.tree-sitter.dispatch-test
                              kmet.extensions.tree-sitter.hooks-test])]
                (doseq [ns-sym nss]
                  (require ns-sym))
                (let [summary (apply clojure.test/run-tests nss)]
                  (when (pos? (+ (:fail summary) (:error summary)))
                    (System/exit 1))))}}}

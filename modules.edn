;; The workspace manifest — see tasks/kmet/tasks/modules.clj for the readers.
;;
;; Classpath and embed order is the listing order (it decides shadowing);
;; :rank is the layering guard's ordering (kmet.test-module-deps). Each
;; module's modules/<name>/deps.edn declares every module and third-party
;; library its src requires and nothing else: its :deps is the src edge list,
;; because a :local/root dependency's aliases never reach the consumer.
;; Test-only libraries belong to the test project (deps.edn's :dev alias); the
;; same guard checks both directions, for module edges and for library
;; coordinates (the host's own artifacts excepted).
;; Extension projects are not workspace modules: each is an independently
;; loadable extension with its own bb.edn test entry (and, when it needs
;; library deps, a deps.edn). The loader, reakt, hikap, srce, tk and tui are
;; the external edges: pinned kmet/* dependencies (tk in the :jvm alias), with
;; their sibling checkouts used as local roots in bb.edn and the :dev alias.
{:modules
 [{:name "libs" :src "modules/libs/src" :test "modules/libs/test" :rank 0}
  ;; The MCP client: protocol core, stdio/HTTP transports and OAuth policy.
  ;; It sits above libs and below the app; the mcp-adapter extension consumes
  ;; it through the shared library allowlist.
  {:name "mcp" :src "modules/mcp/src" :test "modules/mcp/test" :rank 1}
  {:name "ai" :src "modules/ai/src" :test "modules/ai/test" :rank 1}
  ;; The composition layer above the kernel: rows, bundles, profiles, patches,
  ;; cards and mounts. It owns the language; the app supplies the table, the
  ;; source policy and boot/teardown (modules/sklop/README.md).
  {:name "sklop" :src "modules/sklop/src" :test "modules/sklop/test" :rank 2}
  ;; The kmet2 application: shared services, the session layer, the extension
  ;; host (architecture.md § Composition), and the front end. The TUI's widgets,
  ;; selectors and mode row are `kmet.ui.*` under `modules/app/src/kmet/ui` —
  ;; the module that was `ui` until it merged here; the layer guard rules on
  ;; that subtree by path. Every other namespace is kmet.app.* (landing 11
  ;; renamed the ones whose lifts had kept kmet1's names); kmet.extension is
  ;; the ABI and keeps its name.
  {:name "app" :src "modules/app/src" :test "modules/app/test" :rank 3}
]

 :extension-root "extensions"
 ;; :test-hosts [:bb] marks a test tree whose every test var is ^:bb-only: the
 ;; runner skips requiring it on Jolt/JVM, where it would select no vars.
 :extensions
 [{:name "clojure" :src "extensions/clojure/src" :test "extensions/clojure/test"
   :test-hosts [:bb]}
  {:name "tree-sitter" :src "extensions/tree-sitter/src" :test "extensions/tree-sitter/test"
   :test-hosts [:bb]}
  {:name "review" :src "extensions/review/src" :test "extensions/review/test"
   :test-hosts [:bb]}
  {:name "mcp-adapter" :src "extensions/mcp-adapter/src" :test "extensions/mcp-adapter/test"}
  {:name "lsp-adapter" :src "extensions/lsp-adapter/src" :test "extensions/lsp-adapter/test"}]

 ;; Classpath roots beyond the module and extension trees; :test marks the root
 ;; that holds tests (the runner scans module test dirs, this root, and the
 ;; extension test dirs).
 :roots [{:path "test" :test true} {:path "tasks"}]

 ;; jolt's :jolt/build :embed packager roots beside the module sources.
 :jolt-embed-extra ["target/kmet-version" "target/kmet-bundled"]}

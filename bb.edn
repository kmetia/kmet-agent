{:min-bb-version "1.13.225"
 ;; tasks/ is a second source root, not part of the app: every bb-task
 ;; implementation lives there (see AGENTS.md § File layout). Both hosts
 ;; resolve kmet.tasks.* from it, and neither artifact carries it — the
 ;; uberjar walks src/, jolt's :jolt/build :embed does too.
 :paths ["modules/reakt/src" "modules/reakt/test" "modules/hikap/src" "modules/hikap/test" "modules/libs/src" "modules/libs/test" "modules/tui/src" "modules/tui/test" "modules/ai/src" "modules/ai/test" "modules/loader/src" "modules/loader/test" "modules/srce/src" "modules/srce/test" "modules/app/src" "modules/app/test" "modules/tk/src" "modules/tk/test" "test" "tasks" "extensions/clojure/src" "extensions/clojure/test" "extensions/tree-sitter/src" "extensions/tree-sitter/test" "extensions/review/src" "extensions/review/test" "extensions/mcp-adapter/src" "extensions/mcp-adapter/test" "extensions/lsp-adapter/src" "extensions/lsp-adapter/test"]
 :deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}
        ;; babashka >= 1.13.224 bundles data.json (2.5.2 as of 1.13.225) and
        ;; the built-in wins over any declared copy; pinned at the bundled
        ;; version in lockstep with the jolt/JVM classpath (deps.edn).
        ;; Before the bundling, >= 2.5 could not load under SCI (definterface
        ;; in json.clj InternalPBR), hence the old 2.4.0 pin.
        org.clojure/data.json {:mvn/version "2.5.2"}
        ;; Fixed bundled extension set (kmet.app.extensions.libs). rewrite-clj,
        ;; edamame, spec.alpha and tools.reader are bb-bundled ports, so only
        ;; the two Maven-only set members need declaring here; cljfmt above
        ;; serves both the format tasks and the set.
        parinferish/parinferish {:mvn/version "0.8.0"}
        ;; Boundary schemas: validate files and, later,
        ;; wire records at the edges. Prefer malli.core + malli.error only.
        metosin/malli {:mvn/version "0.20.1"}}
 ;; Each :doc is a one-line `bb tasks` summary, a blank line, then the
 ;; details; `bb <task> --help` prints the whole text (kmet.tasks.help).
 ;; :requires here is shared by every task and only pulls in that wrapper.
 :tasks
 {:requires ([kmet.tasks.help :as help])
  start   {:doc "Start kmet (interactive TUI); `bb start --help` for kmet's CLI options"
           :requires ([kmet.app.core :as core])
           :task (apply core/-main *command-line-args*)}
  start-jvm {:doc "Start kmet under JVM Clojure (interactive TUI)\n\nRuns with the app's JVM aliases (:jvm :clj-pin) — the classpath the released JVM artifact gets, extension-dependency resolution included."
             :requires ([babashka.process :as p])
             :task (apply p/shell "clojure" "-M:jvm:clj-pin" "-m" "kmet.app.core" *command-line-args*)}
  uberjar {:doc "Build target/uberjar-bb.jar (run with: bb target/uberjar-bb.jar)\n\nThe babashka payload: an uberjar of src + runtime deps that `bb dist` appends to a babashka release binary. Not JVM-loadable (babashka's built-in namespaces have no source files) — `bb uberjar-jvm` builds the JVM artifact."
           :requires ([kmet.tasks.build :as build])
           :task (help/with-help (build/uberjar*))
           :override-builtin true}
  uberjar-jvm {:doc "Build target/uberjar-jvm.jar (run with: java -jar target/uberjar-jvm.jar)\n\nA self-contained JVM uberjar: the modules, the model catalogs, the staged bundled extensions and a baked version, AOT-compiled behind the :gen-class entry kmet.app.jvm-main, then smoke-tested (`--list-models` + `--version`). Assembled by tools.build under the deps.edn :build alias, so it needs the Clojure CLI; platform-independent, unlike the bb/jolt executables. `bb dist-jvm` packs it for release."
               :requires ([babashka.process :as p])
               :task (help/with-help (p/shell "clojure" "-M:build" "-m" "kmet.tasks.build-jvm"))}
  dist-jvm {:doc "Package the JVM artifact (dist/kmetc-<version>-jvm.zip: kmetc.jar, the kmetc/kmetc.sh/kmetc.bat/kmetc.cmd/kmetc.ps1 launchers and LICENSE)\n\nOne platform-independent zip, no cross-building: the uberjar is built and smoke-tested first, then packed by the same conventions `bb dist` / `jolt dist` use (`jvm` sits in the platform slot, and the kmetc- prefix keeps the command distinct from kmet and kmetj). Needs the Clojure CLI."
            :requires ([babashka.process :as p])
            :task (help/with-help (p/shell "clojure" "-M:build" "-m" "kmet.tasks.build-jvm" "--dist"))}
  dist    {:doc "Package self-contained kmet executables (one platform-qualified zip in dist/, each holding a folder with the executable and LICENSE; bb: uberjar + babashka binary; jolt: AOT via `jolt build`)\n\n`bb dist --help` / `jolt dist --help`: platforms, flags (--force, --smoke, --test, --dev, --out, --static/--dynamic, --boot, --target), artifact naming and layout, and the bundled-extension staging both packagers share."
           :requires ([kmet.tasks.build :as build] [kmet.tasks.build-jolt :as jbuild])
           :task (if (find-var 'clojure.core/*jolt-version*)
                   (apply jbuild/-main *command-line-args*)
                   (apply build/-main *command-line-args*))}
  test    {:doc "Run fast test suites (excludes ^:slow tests)\n\nArgs: plain test var names (bb test test-tool-bash), ns/var pairs, or whole namespaces (bb test kmet.libs.test-fuzzy). Whole-namespace args select non-slow vars; var args ignore slow?. Unloadable namespaces are reported with the load failure reason (full run: all; filtered run: requested only) and fail the run."
           :requires ([kmet.tasks.runner :as runner])
           :task (help/with-help (apply runner/-main false *command-line-args*))
           :override-builtin true}
  test-ext {:doc "Run ONLY the slow (^:slow) test suites\n\nArgs: plain test var names, ns/var pairs, or whole namespaces (bb test-ext kmet.app.test-extensions). Whole-namespace args select slow vars; var args ignore slow?. Unloadable namespaces are reported with the load failure reason (full run: all; filtered run: requested only) and fail the run."
            :requires ([kmet.tasks.runner :as runner])
            :task (help/with-help (apply runner/-main true *command-line-args*))
            :override-builtin true}
  test-jvm {:doc "Run the fast test suites on the JVM host (excludes ^:slow tests)\n\nSame runner, selection and filters as `bb test`, run under JVM Clojure with the app's JVM aliases (:jvm :clj-pin :dev) — the classpath the released JVM artifact gets. Needs the Clojure CLI."
            :requires ([babashka.process :as p])
            :task (help/with-help
                    (apply p/shell "clojure" "-M:jvm:clj-pin:dev" "-m" "kmet.tasks.runner"
                           "false" *command-line-args*))}
  test-ext-jvm {:doc "Run ONLY the slow (^:slow) test suites on the JVM host\n\nSame runner and filters as `bb test-ext`, under JVM Clojure. Needs the Clojure CLI."
                :requires ([babashka.process :as p])
                :task (help/with-help
                        (apply p/shell "clojure" "-M:jvm:clj-pin:dev" "-m" "kmet.tasks.runner"
                               "true" *command-line-args*))}
  test-changed-jvm {:doc "Run the non-slow JVM tests of namespaces affected by changed files\n\nSame affected-namespace set as `bb test-changed`, run under JVM Clojure; full gate: bb test-jvm. Needs the Clojure CLI."
                    :requires ([babashka.process :as p])
                    :task (help/with-help
                            (p/shell "clojure" "-M:jvm:clj-pin:dev" "-m" "kmet.tasks.runner"
                                     "false" "--changed"))}
  test-ext-changed-jvm {:doc "Run ONLY the slow (^:slow) JVM tests of namespaces affected by changed files\n\nFull gate: bb test-ext-jvm. Needs the Clojure CLI."
                        :requires ([babashka.process :as p])
                        :task (help/with-help
                                (p/shell "clojure" "-M:jvm:clj-pin:dev" "-m" "kmet.tasks.runner"
                                         "true" "--changed"))}
  changed {:doc "List files changed since the last commit (git; mtime-since-baseline fallback without git)"
           :requires ([kmet.tasks.changed :as changed])
           :task (help/with-help (doseq [f (changed/changed-files)] (println f)))}
  changed-baseline {:doc "Record 'all gates green as of now' for the mtime fallback (no-op with git)\n\nRun after a full validation."
                    :requires ([kmet.tasks.changed :as changed])
                    :task (help/with-help (do (changed/mark-validated!)
                                              (println "Changed-files baseline updated.")))}
  test-changed {:doc "Run the non-slow tests of namespaces affected by changed files\n\nRequire-graph closure over src/test/tasks/extensions; full gate: bb test; JVM twin: bb test-changed-jvm."
                :requires ([kmet.tasks.runner :as runner])
                :task (help/with-help (runner/run-changed! false))}
  test-ext-changed {:doc "Run ONLY the slow (^:slow) tests of namespaces affected by changed files\n\nRequire-graph closure; full gate: bb test-ext; JVM twin: bb test-ext-changed-jvm."
                    :requires ([kmet.tasks.runner :as runner])
                    :task (help/with-help (runner/run-changed! true))}
  lint-changed {:doc "Lint changed files plus affected dependents over both reader views\n\nFull gate: bb lint (same on both hosts); lints everything when the clj-kondo config changed."
                :requires ([kmet.tasks.lint :as lint])
                :task (help/with-help (lint/lint-changed!))}
  format-changed {:doc "Format changed files in place\n\nFull gate: bb format; jolt format-changed runs the same task."
                  :requires ([kmet.tasks.format :as fmt])
                  :task (help/with-help (fmt/format-changed!))}
  format-check-changed {:doc "Check formatting of changed files\n\nFull gate: bb format-check; jolt format-check-changed runs the same task."
                        :requires ([kmet.tasks.format :as fmt])
                        :task (help/with-help (fmt/format-check-changed!))}
  nrepl  {:doc "Start nREPL server on port 7801 for interactive development"
          :task (help/with-help (do (require 'babashka.nrepl.server)
                                    (println "Starting nREPL on port 7801...")
                                    (babashka.nrepl.server/start-server! {:port 7801})
                                    (println "nREPL started on port 7801")))}
  nrepl-jvm {:doc "Start a JVM nREPL server on port 7803 for interactive development\n\nUsage: bb nrepl-jvm [port]. Runs nrepl.cmdline under JVM Clojure with the app's JVM aliases (:jvm :clj-pin :dev), so the server sees the JVM classpath, extension-dependency resolution and the test paths. The kmet nREPL ports are 7801 (`bb nrepl`), 7802 (jolt's `nrepl-server`), and 7803 (this task); it writes .nrepl-port (gitignored), which `clojure_eval` discovers first."
             :requires ([babashka.process :as p])
             :task (help/with-help
                     (p/shell "clojure" "-M:jvm:clj-pin:dev:nrepl"
                              "-m" "nrepl.cmdline"
                              "--port" (or (first *command-line-args*) "7803")))}
  check   {:doc "Verify all code compiles\n\nLoading the entry in the task body is what proves the app's namespace graph compiles whole; the :requires list names the entry only."
           :requires ([kmet.app.core])
           :task (help/with-help (do (require 'kmet.app.core)
                                     (println "All source namespaces compile successfully.")))
           :override-builtin true}
  generate-models {:doc "Regenerate the committed provider + image model catalogs (network)\n\nProvider catalogs come from models.dev + the live sources; the image catalog from OpenRouter. Either failure exits 1."
                   :requires ([kmet.tasks.generate-models :as gen-models])
                   :task (help/with-help (gen-models/-main))}
  check-model-data {:doc "Offline validation of committed provider + image catalogs + manifest"
                    :requires ([kmet.tasks.generate-models :as gen-models])
                    :task (help/with-help
                            (let [errors (gen-models/validate-all!)]
                              (if (seq errors)
                                (do (println "Invalid model data:")
                                    (doseq [e errors] (println "  -" e))
                                    (System/exit 1))
                                (println "Committed model data is valid."))))}
  generate-catalog {:doc "Regenerate the committed composition catalog (docs/composition.md)\n\nBundles and profiles from the built-in table, the tool surface from a minimal boot; deterministic, so the diff is the change."
                    :requires ([kmet.app.composition-gen :as catalog-gen])
                    :task (help/with-help (println "Wrote" (catalog-gen/write!)))}
  check-catalog {:doc "Check docs/composition.md against the built-in composition (offline)\n\nRun `bb generate-catalog` when it names a difference."
                 :requires ([kmet.app.composition-gen :as catalog-gen])
                 :task (help/with-help
                         (if-let [problem (catalog-gen/check)]
                           (do (println problem) (System/exit 1))
                           (println "The composition catalog is current.")))}
  pack-extension {:doc "Verify an extension artifact root and pack it as .jar\n\nUsage: bb pack-extension <src-dir> [out.jar]; src-dir is the artifact root, e.g. extensions/clojure/src."
                  :requires ([kmet.tasks.build :as build])
                  :task (help/with-help (apply build/pack-extension! *command-line-args*))}
  check-bundled-extensions {:doc "Validate the committed bundled-extensions manifest against extensions/\n\nChecks completeness, extension.edn shape, strict ns layout and deps.edn restrictions; the same check the packagers run before staging."
                            :requires ([kmet.tasks.build :as build])
                            :task (help/with-help (build/check-bundled-extensions!))}
  slop    {:doc "SCBench-style slop metrics over a Clojure tree: verbosity, erosion\n\nOutliers only, compared to the paper's human/agent reference rows; source trees only by default (`--test` adds `test/` and `extensions/*/test`); `--dups` lists duplicate groups — the clone groups behind the clone-line count plus the shape-identical defns the clone floor misses — instead of the outlier listings; `bb slop --help` for the path argument, --top, --test and --dups."
           :requires ([kmet.tasks.slop :as slop])
           :task (apply slop/-main *command-line-args*)}
  lint    {:doc "Lint the tree with clj-kondo over BOTH reader views (babashka + jolt)\n\nEither this or `jolt lint` covers common, bb and jolt code; the babashka view sees the :clj branches, the jolt view the :jolt branches and jolt/. Optionally: specific files/dirs."
           :requires ([kmet.tasks.lint :as lint])
           :task (help/with-help (lint/lint! *command-line-args*))}
  format  {:doc "Format src/test/tasks/extensions with cljfmt (fix in place; same task on both hosts)\n\nOptionally: specific files/dirs; generated model_data catalogs are excluded."
           :requires ([kmet.tasks.format :as fmt])
           :task (help/with-help (fmt/format! *command-line-args*))}
  format-check {:doc "Check src/test/tasks/extensions formatting with cljfmt (no changes; same task on both hosts)\n\nOptionally: specific files/dirs; generated model_data catalogs are excluded."
                :requires ([kmet.tasks.format :as fmt])
                :task (help/with-help (fmt/format-check! *command-line-args*))}
  clean   {:doc "Remove build artifacts, caches, logs and test residue (--dry-run/-n lists only)\n\ntarget/, dist/, extensions/*/target/, .cpcache, .jolt, the clj-kondo cache, *.log and .kmet-changed-baseline. Source, .kmet/ and .lsp/ are never touched; same task on both hosts, `bb clean --help` for the full reference."
           :requires ([kmet.tasks.clean :as clean])
           :task (apply clean/-main *command-line-args*)}
  help    {:doc "Show task entry points"
           :task (do (println "kmet - minimal coding agent")
                     (println)
                     (println "  bb tasks          list tasks")
                     (println "  bb <task> --help  full task help")
                     (println "  bb start --help   kmet CLI options")
                     (println)
                     (println "Changed-file dev loop: changed, test-changed, test-ext-changed,")
                     (println "lint-changed, format-changed, format-check-changed, changed-baseline.")
                     (println "Extension files are covered by lint/format and the changed tasks;")
                     (println "extension tests run from inside their directories (bb test there)."))
           :override-builtin true}}}

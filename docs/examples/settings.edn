{:provider :opencode-go
 :model "deepseek-v4.1-flash"
 :theme "light/dark"
 :thinking :off
 :thinking-mode :visible         ; thinking blocks: :visible (default), :stream-last (the label above the live
                                 ; block's tail while the model thinks, the label alone after), :hidden
 :session-dir "~/.kmet/sessions"
 :auto-compact true
 :compact-token-threshold nil
 :compact-reserve-tokens 16384
 :keep-recent-tokens 20000
 ;; per-model compaction budgets, keyed by the exact "provider/modelId";
 ;; each field falls back to the ordinary keys above
 ;; (pi: compaction.modelOverrides)
 :compact-model-overrides {}
 :retry {:enabled true
         :max-retries 3
         :base-delay-ms 2000}
 :loop-guard {:enabled true
              :threshold 3}
 :thinking-loop-guard-enabled true
 :steering-mode :all
 :follow-up-mode :one-at-a-time
 :http-idle-timeout-ms 120000   ; stream idle gap + response-start wait; 0 disables both
 :http-total-timeout-ms 0       ; 0 disables total timeout; nil follows idle
 :http-transport :platform
 :shell-path nil
 :shell-command-prefix nil
 ;; scoped resource selection, e.g. {:tools ["-bash"]}; global lists
 ;; select or modify the defaults, project lists are +name/-name deltas over
 ;; global. See docs/configuration.md#tools. The old :default-tools and
 ;; :enabled-tools keys are ignored.
 :resources {}
 :terminal {:show-images true
            :image-width-cells 60
            :clear-on-shrink false}
 :images {:block-images false}
 :system-prompt nil
 :append-system-prompt nil}
